# Frontend configuration. Copy to .env.local and adjust as needed.
# Every value below is optional; the defaults suit local development.

# Base URL the browser uses for API calls. Defaults to the relative path /api,
# which the development server proxies to the backend. Set an absolute URL to
# call the backend directly, which also requires CORS_ALLOWED_ORIGINS on the
# backend to include this frontend's origin.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend that the development server proxies /api to.
# BACKEND_URL=http://127.0.0.1:8000

# Port the development server listens on.
# FRONTEND_PORT=5173
